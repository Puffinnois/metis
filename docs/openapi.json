{
  "openapi": "3.0.3",
  "info": {
    "title": "Metis NBA Stats API",
    "description": "Local-first NBA statistics API. All list responses include a `coverage` envelope field indicating whether the requested stats fall within the historical coverage window.",
    "license": {
      "name": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/games": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "List games with optional filters for `season_id`, `season_type`, and `team_id`.",
        "operationId": "list_games",
        "parameters": [
          {
            "name": "season_id",
            "in": "query",
            "description": "Filter by season label, e.g. 2023-24",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "season_type",
            "in": "query",
            "description": "Filter by season type, e.g. Regular",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "description": "Filter by team id (home or away)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of games",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/games/{id}": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "Get a single game by id.",
        "operationId": "get_game",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Game id, e.g. nba_stats_0022300001",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Game found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Game not found"
          }
        }
      }
    },
    "/players": {
      "get": {
        "tags": [
          "players"
        ],
        "summary": "List all players, with optional `league_id` and `search` filters.",
        "operationId": "list_players",
        "parameters": [
          {
            "name": "league_id",
            "in": "query",
            "description": "Filter by league id",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive name substring search",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of players",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/players/stats": {
      "get": {
        "tags": [
          "players"
        ],
        "summary": "List player season statistics with filtering, sorting, and pagination.",
        "description": "Supports filtering by season(s), season type, team, date range, home/away,\nand win/loss, plus four display modes (totals, per-game, per-36, per-100).\nDate range / home-away / win-loss filters trigger on-the-fly aggregation of\n`player_game_box`; all other combinations read from precomputed season\nrollup tables.",
        "operationId": "list_player_stats",
        "parameters": [
          {
            "name": "season_id",
            "in": "query",
            "description": "Comma-separated season labels, e.g. 2022-23,2023-24 (OR'd)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "season_type",
            "in": "query",
            "description": "Filter by season type, e.g. Regular",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "description": "Filter by player's team for the stint",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "description": "Inclusive ISO-8601 lower bound on game date",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "description": "Inclusive ISO-8601 upper bound on game date",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "home_away",
            "in": "query",
            "description": "\"home\" or \"away\"",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "win_loss",
            "in": "query",
            "description": "\"win\" or \"loss\"",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "display_mode",
            "in": "query",
            "description": "\"totals\", \"per_game\", \"per_36\", or \"per_100\"",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Ingest adapter name, defaults to nba_stats",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Stat column to sort by, defaults to points",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "\"asc\" or \"desc\", defaults to desc",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1-indexed page number, defaults to 1",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true,
              "minimum": 0
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Page size, clamped to [1, 200], defaults to 50",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated player season stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerStatsPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter, sort, or pagination parameter"
          }
        }
      }
    },
    "/players/{id}": {
      "get": {
        "tags": [
          "players"
        ],
        "summary": "Get a single player by id.",
        "operationId": "get_player",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Player composite id, e.g. NBA_2544",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Player not found"
          }
        }
      }
    },
    "/seasons": {
      "get": {
        "tags": [
          "seasons"
        ],
        "summary": "List all seasons, with an optional `league_id` filter.",
        "description": "Results are ordered by `start_year` descending (most-recent first).",
        "operationId": "list_seasons",
        "parameters": [
          {
            "name": "league_id",
            "in": "query",
            "description": "Filter by league id",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of seasons",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/teams": {
      "get": {
        "tags": [
          "teams"
        ],
        "summary": "List all teams, with an optional `league_id` filter.",
        "operationId": "list_teams",
        "parameters": [
          {
            "name": "league_id",
            "in": "query",
            "description": "Filter by league id",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of teams",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/teams/{id}": {
      "get": {
        "tags": [
          "teams"
        ],
        "summary": "Get a single team by id.",
        "operationId": "get_team",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Team composite id, e.g. NBA_BOS",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Team not found"
          }
        }
      }
    },
    "/views": {
      "get": {
        "tags": [
          "views"
        ],
        "summary": "List all saved views, optionally filtered by `entity_type`.",
        "operationId": "list_views",
        "parameters": [
          {
            "name": "entity_type",
            "in": "query",
            "description": "Filter by entity type: player or team",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of saved views",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "views"
        ],
        "summary": "Create a new saved view.",
        "operationId": "create_view",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserViewDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewItemResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/views/{id}": {
      "get": {
        "tags": [
          "views"
        ],
        "summary": "Retrieve a single saved view by id.",
        "operationId": "get_view",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Saved view UUID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "tags": [
          "views"
        ],
        "summary": "Delete a saved view.",
        "operationId": "delete_view",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Saved view UUID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "patch": {
        "tags": [
          "views"
        ],
        "summary": "Update an existing saved view (partial update — only supplied fields change).",
        "operationId": "update_view",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Saved view UUID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserViewDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CoverageLabel": {
        "type": "string",
        "description": "Coverage label attached to every response.",
        "enum": [
          "full",
          "partial",
          "none"
        ]
      },
      "CreateUserViewDto": {
        "type": "object",
        "description": "Request body for `POST /views`.",
        "required": [
          "id",
          "name",
          "entity_type"
        ],
        "properties": {
          "columns": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "entity_type": {
            "type": "string",
            "description": "`\"player\"` or `\"team\"`."
          },
          "filters": {
            "type": "string",
            "description": "Serialized filter state; defaults to `{}` if omitted.",
            "nullable": true
          },
          "id": {
            "type": "string",
            "description": "Client-generated UUID."
          },
          "is_default": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "sort_config": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "GameDto": {
        "type": "object",
        "description": "Game entity as returned by the API.",
        "required": [
          "id",
          "league_id",
          "season_id",
          "season_type",
          "game_date",
          "home_team_id",
          "away_team_id",
          "status"
        ],
        "properties": {
          "away_score": {
            "type": "integer",
            "format": "int32",
            "description": "`null` until the game is final.",
            "nullable": true
          },
          "away_team_id": {
            "type": "string"
          },
          "game_date": {
            "type": "string",
            "description": "ISO-8601 date string."
          },
          "home_score": {
            "type": "integer",
            "format": "int32",
            "description": "`null` until the game is final.",
            "nullable": true
          },
          "home_team_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "league_id": {
            "type": "string"
          },
          "season_id": {
            "type": "string",
            "description": "Season label, e.g. `\"2023-24\"`."
          },
          "season_type": {
            "type": "string",
            "description": "One of `Regular`, `Playoffs`, `PlayIn`, `AllStar`, `Preseason`."
          },
          "status": {
            "type": "string",
            "description": "One of `scheduled`, `live`, `final`."
          }
        }
      },
      "GameItemResponse": {
        "type": "object",
        "description": "Single game.",
        "required": [
          "data",
          "coverage"
        ],
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/CoverageLabel"
          },
          "data": {
            "$ref": "#/components/schemas/GameDto"
          }
        }
      },
      "GameListResponse": {
        "type": "object",
        "description": "List of games.",
        "required": [
          "data",
          "total",
          "coverage"
        ],
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/CoverageLabel"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameDto"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PlayerDto": {
        "type": "object",
        "description": "Player entity as returned by the API.",
        "required": [
          "id",
          "league_id",
          "first_name",
          "last_name"
        ],
        "properties": {
          "birth_date": {
            "type": "string",
            "description": "ISO-8601 date string, or `null` when not reported.",
            "nullable": true
          },
          "first_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Composite key, e.g. `\"NBA_2544\"`."
          },
          "last_name": {
            "type": "string"
          },
          "league_id": {
            "type": "string"
          }
        }
      },
      "PlayerItemResponse": {
        "type": "object",
        "description": "Single player.",
        "required": [
          "data",
          "coverage"
        ],
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/CoverageLabel"
          },
          "data": {
            "$ref": "#/components/schemas/PlayerDto"
          }
        }
      },
      "PlayerListResponse": {
        "type": "object",
        "description": "List of players.",
        "required": [
          "data",
          "total",
          "coverage"
        ],
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/CoverageLabel"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerDto"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PlayerStatsPageResponse": {
        "type": "object",
        "description": "Paginated response envelope for `GET /players/stats`.\n\nUses `rows` (not the generic `data`) to distinguish stat rows from entity\nlists and to match the Tauri command response shape.",
        "required": [
          "rows",
          "total",
          "page",
          "page_size",
          "coverage"
        ],
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/CoverageLabel"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page_size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerStatsRowDto"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "PlayerStatsRowDto": {
        "type": "object",
        "description": "A row of player season statistics as returned by `GET /players/stats`.\n\nField semantics depend on the requested `display_mode`: for `totals` these\nare season counting-stat sums; for `per_game` / `per_36` / `per_100` they are\nthe corresponding rate stats. `null` means the underlying source did not\nreport that stat (or, for rate stats, that the denominator was zero).",
        "required": [
          "player_id",
          "season_id",
          "season_type",
          "source",
          "games_played"
        ],
        "properties": {
          "assists": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "blocks": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "field_goals_attempted": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "field_goals_made": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "free_throws_attempted": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "free_throws_made": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "games_played": {
            "type": "integer",
            "format": "int32"
          },
          "minutes_played": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "personal_fouls": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "player_id": {
            "type": "string"
          },
          "points": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "rebounds_defensive": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "rebounds_offensive": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "rebounds_total": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "season_id": {
            "type": "string",
            "description": "Season label, e.g. `\"2023-24\"`."
          },
          "season_type": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Ingest adapter name, e.g. `\"nba_stats\"`."
          },
          "steals": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "three_pointers_attempted": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "three_pointers_made": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "turnovers": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "SeasonDto": {
        "type": "object",
        "description": "Season entity as returned by the API.",
        "required": [
          "id",
          "league_id",
          "start_year",
          "end_year"
        ],
        "properties": {
          "end_year": {
            "type": "integer",
            "format": "int32"
          },
          "id": {
            "type": "string",
            "description": "Season label, e.g. `\"2023-24\"`."
          },
          "league_id": {
            "type": "string"
          },
          "start_year": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SeasonListResponse": {
        "type": "object",
        "description": "List of seasons.",
